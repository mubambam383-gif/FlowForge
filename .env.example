# Supabase client configuration (safe to expose in the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secrets for localhost Express routes and Vercel API functions.
# Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Optional local server port. Vercel ignores this.
PORT=3000
