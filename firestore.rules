rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function userId() {
      return request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Collection
    match /users/{uid} {
      allow get: if isSignedIn() && (userId() == uid);
      allow list: if false; 
      
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
               data.uid == userId() &&
               data.email is string && data.email.size() <= 256 &&
               data.createdAt == request.time;
      }

      allow create: if isSignedIn() && isValidUser(incoming());
      allow update: if isSignedIn() && userId() == uid && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'currentOrganizationId'])
      );

      // User-specific webhook events (for the lab)
      match /webhooks/main/events {
        allow list: if isSignedIn() && userId() == uid;
        match /{eventId} {
          allow get: if isSignedIn() && userId() == uid;
          allow create: if true; 
        }
      }
    }

    // 2. Organizations
    match /organizations/{orgId} {
      function isMember(oId) {
        // Simple ownership check for now, in a real app we'd check a members subcollection
        return get(/databases/$(database)/documents/organizations/$(oId)).data.ownerId == userId();
      }

      allow get: if isSignedIn() && (existing().ownerId == userId());
      allow list: if isSignedIn() && resource.data.ownerId == userId();

      function isValidOrg(data) {
        return data.keys().hasAll(['name', 'ownerId', 'createdAt']) &&
               data.keys().size() == 3 &&
               data.name is string && data.name.size() <= 128 &&
               data.ownerId == userId() &&
               data.createdAt == request.time;
      }

      allow create: if isEmailVerified() && isValidOrg(incoming());
      allow update: if isEmailVerified() && existing().ownerId == userId() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name'])
      );
    }

    // 3. Projects
    match /projects/{projectId} {
      function orgId() {
        return incoming().organizationId;
      }
      
      function belongsToOrg(oId) {
        return get(/databases/$(database)/documents/organizations/$(oId)).data.ownerId == userId();
      }

      allow get: if isSignedIn() && belongsToOrg(existing().organizationId);
      allow list: if isSignedIn() && belongsToOrg(resource.data.organizationId);

      function isValidProject(data) {
        return data.keys().hasAll(['name', 'organizationId', 'createdAt']) &&
               data.keys().size() <= 4 &&
               data.name is string && data.name.size() <= 128 &&
               belongsToOrg(data.organizationId) &&
               data.createdAt == request.time;
      }

      allow create: if isEmailVerified() && isValidProject(incoming());
      allow update: if isEmailVerified() && belongsToOrg(existing().organizationId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description'])
      );
      
      // Subcollections: Requests, Webhooks, Environments, Mocks
      match /requests/{requestId} {
        allow read: if isSignedIn() && belongsToOrg(get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId);
        
        function isValidRequest(data) {
          return data.keys().hasAll(['projectId', 'name', 'method', 'url', 'createdAt']) &&
                 data.projectId == projectId &&
                 data.method in ['GET', 'POST', 'PUT', 'PATCH', 'DELETE'] &&
                 data.createdAt == request.time;
        }

        allow create: if isEmailVerified() && isValidRequest(incoming());
        allow update: if isEmailVerified() && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'method', 'url', 'headers', 'body', 'auth', 'params', 'lastExecuted'])
        );
      }

      match /webhooks/{webhookId} {
        allow read: if isSignedIn() && belongsToOrg(get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId);
        
        function isValidWebhook(data) {
          return data.keys().hasAll(['projectId', 'name', 'slug', 'createdAt']) &&
                 data.projectId == projectId &&
                 data.createdAt == request.time;
        }

        allow create: if isEmailVerified() && isValidWebhook(incoming());
        allow update: if isEmailVerified() && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'isActive', 'secret'])
        );

        match /events/{eventId} {
          allow read: if isSignedIn() && belongsToOrg(get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId);
          // Events are strictly system-generated in real flow, but for simulation let's allow it
          allow create: if isSignedIn(); 
        }
      }
    }
  }
}
